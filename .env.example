# Gemini API key used only by the server. It enables Gemini plus Google Search
# and Google Maps grounding; the key is never sent to the browser.
# Create your own .env file and never commit the real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Free-tier-compatible Flash Lite model. Search and Maps run as separate calls;
# Google Search Grounding may still require billing depending on the project.
GEMINI_MODEL="gemini-3.1-flash-lite"

# Tavily supplies source-backed web, social, menu and image search.
# The free developer plan currently includes monthly search credits.
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Stripe secret key (sk_test_... or sk_live_...) for creating PaymentIntents and Checkout Sessions.
STRIPE_SECRET_KEY=""

# STRIPE_PUBLISHABLE_KEY: Stripe publishable key (pk_test_... or pk_live_...) for client-side Elements.
STRIPE_PUBLISHABLE_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional webhook signing secret (whsec_...) for verifying Stripe event signatures.
STRIPE_WEBHOOK_SECRET=""
